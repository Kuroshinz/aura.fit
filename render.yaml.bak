# Render.com Blueprint for AURA.FIT Telegram Bot Backend
#
# Note: To prevent the free web service from sleeping after 15 mins of inactivity,
# sign up for UptimeRobot (free) and create a monitor that pings
# https://aura-fit-bot.onrender.com every 5 minutes.

services:
  # Main Python Web Service (Telegram Bot + Webhook API)
  - type: web
    name: aura-fit-bot
    env: docker
    region: singapore
    plan: free
    dockerfilePath: ./python_backend/Dockerfile
    envVars:
      - key: TELEGRAM_TOKEN
        sync: false
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_KEY
        sync: false
      - key: WEBHOOK_SECRET
        sync: false
      - key: DEFAULT_TELEGRAM_CHAT_ID
        sync: false
